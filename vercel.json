{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/sangdamso",
      "destination": "/sangdamso.html"
    },
    {
      "source": "/winners",
      "destination": "/winners.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
